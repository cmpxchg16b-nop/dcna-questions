# systemd unit for ExamServer.
# Generated from scripts/exam-server.service by
# scripts/install-systemd-service.sh; edit the template, then re-run the
# installer instead of modifying the installed copy.

[Unit]
Description=ExamServer - exam practice site
Documentation=https://github.com/cmpxchg16b-nop/dcna-questions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/server --addr=:18971 --assets-dir=assets --load-exam-dir=exams-dn42 --config-xml=serverConfig.xml --sysadmin-email=i@exploro.one
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

# The server loads .env.local / .env from WorkingDirectory at startup
# (see loadDotEnvFiles in cmd/server/main.go), so JWT_SECRET and other
# environment settings live there - no Environment= lines needed here.

[Install]
WantedBy=multi-user.target
