<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="title" type="xs:string" />
  <xs:element name="description" type="xs:string">
    <xs:annotation>
      <xs:documentation xml:lang="en">Description of an exam object or a question object.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:simpleType name="QuestionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="single-choice" />
      <xs:enumeration value="multiple-choice" />
      <xs:enumeration value="drag-and-drop" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="option">
    <xs:annotation>
      <xs:documentation xml:lang="en">Representing an option in a single-choice or multiple-choice question. The &#x60;id&#x60; attribute have to be unique within the question scope.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="id" type="xs:string" use="required" />
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="options">
    <xs:annotation>
      <xs:documentation xml:lang="en">A options enclosure is simply a container of options</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="option" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="combination">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="option" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="connect">
    <xs:annotation>
      <xs:documentation xml:lang="en">Represent a connection line in Cisco-flavor drag-and-drop exam question.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="dst" type="xs:string" use="required" />
      <xs:attribute name="src" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="connections">
    <xs:annotation>
      <xs:documentation xml:lang="en">A connections object is simply a container of a list of connects that occurs in a submitting answer.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="connect" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="connectsource">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="connectdestination">
    <xs:complexType>
      <xs:attribute name="id" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="connectcombination">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="connectsource" minOccurs="1" maxOccurs="unbounded" />
        <xs:element ref="connectdestination" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="connectionsolution">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="connect" minOccurs="0" maxOccurs="unbounded" />
        <xs:element ref="connectcombination" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="requiredUniqueConnections" type="xs:integer" use="required">
        <xs:annotation>
          <xs:documentation>Dictating the fixed number of unique connections to make the answer to be valid</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="connectionsolutions">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="connectionsolution" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="correctanswer">
    <xs:annotation>
      <xs:documentation xml:lang="en">A correctanswer object must contain enough information to enable it to test the correctness of submitting answer.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="options" minOccurs="0" maxOccurs="1" />
        <xs:element ref="combination" minOccurs="0" maxOccurs="1" />
        <xs:element ref="connectionsolutions" minOccurs="0" maxOccurs="1" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="image">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" />
    </xs:complexType>
  </xs:element>
  <xs:element name="exhibit">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="image" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="exhibits">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="exhibit" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="candidate">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="id" use="required" />
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="candidates">
    <xs:annotation>
      <xs:documentation xml:lang="en">Represent a drag-and-drop source area</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="candidate" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="drop">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="id" type="xs:string" use="required" />
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="drops">
    <xs:annotation>
      <xs:documentation xml:lang="en">Represent a drag-and-drop drop area</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="drop" minOccurs="1" maxOccurs="unbounded"></xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="droparealabel">
    <xs:annotation>
      <xs:documentation>Represent a label in a drop area</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="droparea">
    <xs:annotation>
      <xs:documentation xml:lang="en">Represent a drop section in a multi-subsection drops</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="droparealabel" minOccurs="0" maxOccurs="unbounded" />
        <xs:element ref="drop" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="multiareadrop">
    <xs:annotation>
      <xs:documentation xml:lang="en">Represent a drag-and-drop drop area that was divided into multiple sub-sections</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="droparea" minOccurs="1" maxOccurs="unbounded"></xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="imgDragAndDrop">
    <xs:annotation>
      <xs:documentation>Drag-and-drop question based on image clips, drag and drop all the image snippets to the correct positions to pass.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="imgCandidate" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="nodeId" type="xs:string" use="required" />
            <xs:attribute name="nodeLabel" type="xs:string" use="required">
              <xs:annotation>
                <xs:documentation>Descriptive text, usually reflects the answer in text, for the drag-and-drop option, use for rendering correct answer in the frontend.</xs:documentation>
              </xs:annotation>
            </xs:attribute>
            <xs:attribute name="width" type="xs:integer" use="required" />
            <xs:attribute name="height" type="xs:integer" use="required" />
            <xs:attribute name="imgDataSrc" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="imgDropsArea" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="imgDrop" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="nodeId" type="xs:string" use="required" />
                  <xs:attribute name="nodeLabel" type="xs:string" use="required">
                    <xs:annotation>
                      <xs:documentation>Descriptive text, usually reflects the drop in text, for the drag-and-drop option, use for rendering correct answer in the frontend.</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                  <xs:attribute name="positionX" type="xs:integer" use="required" />
                  <xs:attribute name="positionY" type="xs:integer" use="required" />
                  <xs:attribute name="width" type="xs:integer" use="required" />
                  <xs:attribute name="height" type="xs:integer" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="imgBackgroundUrl" type="xs:string" use="required" />
            <xs:attribute name="width" type="xs:integer" use="required" />
            <xs:attribute name="height" type="xs:integer" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="question">
    <xs:annotation>
      <xs:documentation xml:lang="en">A question enclosure models a Cisco-flavor exam question: like a single-choice, a multiple-choice or a drag-and-drop question. The &#x60;id&#x60; attribute of the question has to be unique within the surrounding question collection scope.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="description" />
        <xs:element ref="exhibits" minOccurs="0" maxOccurs="1" />
        <xs:element ref="options" minOccurs="0" maxOccurs="1" />
        <xs:element ref="candidates" minOccurs="0" maxOccurs="1" />
        <xs:element ref="imgDragAndDrop" minOccurs="0" maxOccurs="1" />
        <xs:element ref="multiareadrop" minOccurs="0" maxOccurs="1" />
        <xs:element ref="drops" minOccurs="0" maxOccurs="1" />
        <xs:element ref="correctanswer" minOccurs="1" maxOccurs="1" />
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required" />
      <xs:attribute name="type" type="QuestionType" use="required" />
      <xs:attribute name="score" type="xs:float" use="required"></xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="questioncollection">
    <xs:annotation>
      <xs:documentation xml:lang="en">A question collection is just a ordered list of questions</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="question" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="questionset">
    <xs:annotation>
      <xs:documentation xml:lang="en">A question set can have one or more question collections, to allow picking up a random question collection when starting a new exam.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="questioncollection" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="ExamCategory">
    <xs:restriction base="xs:string">
      <xs:enumeration value="certification-exam">
        <xs:annotation>
          <xs:documentation>A proctored, high-stakes assessment delivered through an authorized testing provider that, when passed, grants an official vendor certification valid for a set period.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="practice-exam">
        <xs:annotation>
          <xs:documentation>An unproctored study tool that simulates the exam format and provides detailed feedback on incorrect answers to help candidates assess their readiness without awarding certification.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="exam">
    <xs:annotation>
      <xs:documentation xml:lang="en">An exam is a container that contains a set of question collections that focus on a specific topic.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="title" minOccurs="1" maxOccurs="1" />
        <xs:element ref="description" minOccurs="1" maxOccurs="1" />
        <xs:element name="passingscore" minOccurs="0" maxOccurs="1" type="xs:float" />
        <xs:element name="examcategory" minOccurs="1" maxOccurs="1" type="ExamCategory" />
        <xs:element ref="questionset" minOccurs="1" maxOccurs="1" />
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>This is the exam document id, not the exam session id.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="shortname" type="xs:string" />
      <xs:attribute name="code" type="xs:string" />
    </xs:complexType>
  </xs:element>
  <xs:element name="answer">
    <xs:annotation>
      <xs:documentation xml:lang="en">Answer targeting a single question</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="options" minOccurs="0" maxOccurs="1" />
        <xs:element ref="connections" minOccurs="0" maxOccurs="1" />
      </xs:sequence>
      <xs:attribute name="questionId" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="en">The &#x60;questionId&#x60; attribute targeting a specific question within a question collection which is specified by the parent examanswer object.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="questionType" type="QuestionType" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="en">Specify the question type in the attribute of an answer object to facilitate the validation of the schema of a submitting answer.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="examanswer">
    <xs:annotation>
      <xs:documentation xml:lang="en">An examanswer enclosure represents a submitting answer targeting the whole exam paper of the selected question collection index, the exam server use the correctanswer as defined in the question object to validate the correctness of the submitting answer.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="answer" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="OverallResultType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pass" />
      <xs:enumeration value="immediate" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="overallresult" type="OverallResultType" />
  <xs:element name="scoreresult">
    <xs:complexType>
      <xs:attribute name="earnedScore" type="xs:float" use="required" />
      <xs:attribute name="totalScore" type="xs:float" use="required" />
    </xs:complexType>
  </xs:element>
  <xs:element name="questionscore">
    <xs:complexType>
      <xs:attribute name="questionId" type="xs:string" />
      <xs:attribute name="scoreEarned" type="xs:float" />
    </xs:complexType>
  </xs:element>
  <xs:element name="assessment">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="overallresult" minOccurs="0" maxOccurs="1" />
        <xs:element ref="scoreresult" minOccurs="0" maxOccurs="1" />
        <xs:element ref="questionscore" minOccurs="0" maxOccurs="unbounded" />
        <xs:element ref="question" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation xml:lang="en">Includes the original question in the document of assessment only when the category of exam is practice-exam, for certification-exam, we won't include the origin in the assessment document.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="examtaker">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="person" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required" />
            <xs:attribute name="fistname" type="xs:string" use="optional" />
            <xs:attribute name="lastname" type="xs:string" use="optional" />
          </xs:complexType>
        </xs:element>
        <xs:element name="anonymous" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="sessionid" type="xs:string" use="required">
              <xs:annotation>
                <xs:documentation>The session id of the anonymous user, or just user session id.</xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="examreport">
    <xs:annotation>
      <xs:documentation xml:lang="en">An exam report is a full report sending to the exam assessment tracking server after an exam taker has finished the exam session.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="examtaker" minOccurs="1" maxOccurs="1" />
        <xs:element name="examid" type="xs:string" minOccurs="1" maxOccurs="1">
          <xs:annotation>
            <xs:documentation>This is the exam document id, not the exam session id.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="examshortname" type="xs:string" />
        <xs:element name="examcode" type="xs:string" />
        <xs:element ref="title">
          <xs:annotation>
            <xs:documentation>The title of the exam</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element ref="description" minOccurs="0" maxOccurs="1">
          <xs:annotation>
            <xs:documentation>The description of the exam, optional</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="passingscore" minOccurs="0" maxOccurs="1" type="xs:float">
          <xs:annotation>
            <xs:documentation>The mandated passing score of the exam, should be copied directly from the exam element.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="examcategory" minOccurs="1" maxOccurs="1" type="ExamCategory">
          <xs:annotation>
            <xs:documentation>Should be copied directly from the origin exam document too.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="examsessionid" minOccurs="1" maxOccurs="1" type="xs:string">
          <xs:annotation>
            <xs:documentation>The id of the exam session which the exam taker was in.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="finishedat" minOccurs="1" maxOccurs="1" type="xs:integer">
          <xs:annotation>
            <xs:documentation>The millisecond-resolution unix timestamp when the exam session was finished by the exam taker.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element ref="assessment">
          <xs:annotation>
            <xs:documentation>The element contains the grade and the score that was achieved by the exam taker.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>This is the id of the exam report, it has to be globally unique, not the id of the exam document, nor the id of the exam session.</xs:documentation>
        </xs:annotation>
      </xs:attribute>

    </xs:complexType>
  </xs:element>
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="exam" minOccurs="0" maxOccurs="unbounded" />
        <xs:element ref="examanswer" minOccurs="0" maxOccurs="1" />
        <xs:element ref="assessment" minOccurs="0" maxOccurs="1" />
        <xs:element ref="examreport" minOccurs="0" maxOccurs="1" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>