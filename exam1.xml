  <assessment>
    <overallresult>pass</overallresult>
    <scoreresult earnedScore="85.5" totalScore="100" />
    <questionscore scoreEarned="1.0" questionId="1" />
    <questionscore scoreEarned="1.0" questionId="2" />
    <questionscore scoreEarned="1.0" questionId="3" />
  </assessment>
</root>