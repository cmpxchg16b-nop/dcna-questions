<?xml version="1.0" encoding="UTF-8"?>
<!-- OIDC login options consumed by the server's generic OIDC login handler
     (pkg/api/login/oidc/general/oidcgeneral.go). Each <oidcLoginOption/>
     configures one OIDC provider. Entries with empty issuerURL are ignored
     by the server. Validated against oidcLoginOptions.xsd (project root).

     sessionLifespan is a Go time.Duration string (e.g. "168h"); when omitted
     the handler's code-side default applies. -->
<oidcLoginOptions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="oidcLoginOptions.xsd"
>
  <oidcLoginOption
    providerName="iedon"
    issuerURL="https://auth.iedon.net"
    clientId=""
    clientSecret=""
    redirectURL="http://localhost:8080/api/login/oidc/iedon/auth"
    scope="openid profile email"
    sessionLifespan="168h"
    loginSuccessRedirectURL="/"
  />
</oidcLoginOptions>