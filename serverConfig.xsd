<?xml version="1.0" encoding="UTF-8" ?>
<!-- Schema for serverConfig.xml, the global server configuration document.
     The XML instance references this schema via
     xsi:noNamespaceSchemaLocation="serverConfig.xsd". -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- Root element; holds the global configuration sections. Each section is
       optional so a minimal document enables only what it needs. -->
  <xsd:element name="serverConfig">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element
          name="oidcLoginOptions"
          type="oidcLoginOptionsType"
          minOccurs="0"
        />
        <xsd:element name="smtpServer" type="smtpServerType" minOccurs="0" />
        <xsd:element
          name="loginOptions"
          type="loginOptionsType"
          minOccurs="0"
        />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- The configurable list of generic OIDC login providers; holds zero or
       more oidcLoginOption entries. -->
  <xsd:complexType name="oidcLoginOptionsType">
    <xsd:sequence>
      <xsd:element
        name="oidcLoginOption"
        type="oidcLoginOptionType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
    </xsd:sequence>
  </xsd:complexType>

  <!-- A single OIDC provider configuration. Attribute names mirror the Go
       struct fields of GenericOIDCLoginHandler (with a lowercased first
       letter), and map directly onto the constructor parameters of
       NewGenericOIDCLoginHandler.

       Attributes with sensible code-side defaults are optional here:
         * providerName      defaults to "oidc"
         * scope             defaults to "openid profile email"
         * sessionLifespan   a Go time.Duration string (e.g. "168h")
         * loginSuccessRedirectURL  defaults to "/"

       Attributes without defaults are required:
         * issuerURL, clientId, clientSecret, redirectURL -->
  <xsd:complexType name="oidcLoginOptionType">
    <xsd:attribute name="issuerURL" type="xsd:string" use="required" />
    <xsd:attribute name="clientId" type="xsd:string" use="required" />
    <xsd:attribute name="clientSecret" type="xsd:string" use="required" />
    <xsd:attribute name="redirectURL" type="xsd:string" use="required" />
    <xsd:attribute name="providerName" type="xsd:string" use="optional" />
    <xsd:attribute name="scope" type="xsd:string" use="optional" />
    <xsd:attribute name="sessionLifespan" type="xsd:string" use="optional" />
    <xsd:attribute
      name="loginSuccessRedirectURL"
      type="xsd:string"
      use="optional"
    />
  </xsd:complexType>

  <!-- The outbound SMTP service used to deliver notification messages,
       consumed by EmailBasedMsgSvc in pkg/models/msgnotify.

       Attributes:
         * host, port          required; the SMTP server to connect to
         * username, password  optional; when username is omitted the server
                               is used without authentication
         * startTLS            optional boolean (default false); connect in
                               plaintext, then upgrade via a mandatory
                               STARTTLS command
         * tls                 optional boolean (default false); implicit TLS
                               from the first byte ("smtps", typically
                               port 465)

       startTLS and tls are mutually exclusive; when both are false the
       connection is plaintext. The mutual exclusion is enforced by the Go
       wiring (XSD 1.0 cannot express it for attributes). -->
  <xsd:complexType name="smtpServerType">
    <xsd:attribute name="host" type="xsd:string" use="required" />
    <xsd:attribute name="port" type="xsd:int" use="required" />
    <xsd:attribute name="username" type="xsd:string" use="optional" />
    <xsd:attribute name="password" type="xsd:string" use="optional" />
    <xsd:attribute name="startTLS" type="xsd:boolean" use="optional" />
    <xsd:attribute name="tls" type="xsd:boolean" use="optional" />
  </xsd:complexType>

  <!-- The login page's configurable IdP list; holds zero or more loginOption
       entries. Served to the frontend as JSON by the login options API
       handler (pkg/api/loginoptions, GET /api/login/loginoptions). -->
  <xsd:complexType name="loginOptionsType">
    <xsd:sequence>
      <xsd:element
        name="loginOption"
        type="loginOptionType"
        minOccurs="0"
        maxOccurs="unbounded"
      />
    </xsd:sequence>
  </xsd:complexType>

  <!-- A single login option. kind identifies the IdP type and selects the
       login icon on the frontend; name is the option's unique key. Several
       options may share a kind under different names (e.g. "entra-public"
       and "entra-corporation", both with kind "entra"). Options with an
       empty loginURL are hidden by the login page. -->
  <xsd:complexType name="loginOptionType">
    <xsd:attribute name="kind" type="xsd:string" use="required" />
    <xsd:attribute name="name" type="xsd:string" use="required" />
    <xsd:attribute name="displayName" type="xsd:string" use="required" />
    <xsd:attribute name="loginURL" type="xsd:string" use="required" />
    <xsd:attribute name="label" type="xsd:string" use="optional" />
  </xsd:complexType>

</xsd:schema>
