<?xml version="1.0" encoding="UTF-8"?>
<root
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../exams/exam.xsd"
>
  <exam id="certification-caro-b" shortname="CARO-B" code="B">
    <title>业余无线电台操作技术能力验证-B类考试题</title>
    <description>根据《业余无线电台管理办法（2024年版）》，取得B类业余无线电台操作技术能力验证证书的，可以申请设置、使用工作在30MHz以下频段且最大发射功率小于15瓦，或者工作在30MHz以上频段且最大发射功率不大于25瓦的业余无线电台。</description>
    <passingscore>914</passingscore>
    <examcategory>certification-exam</examcategory>
    <questionset>
      <!-- A question set can contain multiple question collection candidate, to improve uncertainty by picking random question collection out of a multi-collection question set. -->
      <questioncollection>
        <question id="1" type="multiple-choice" score="1">
          <description>我国专门针对无线电管理的行政法规及其制定机构是：</description>
          <options>
            <option id="1">《中华人民共和国无线电管理条例》</option>
            <option id="2">《中华人民共和国无线电管理办法》</option>
            <option id="3">国务院和中央军委</option>
            <option id="4">工业和信息化部</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">《中华人民共和国无线电管理条例》</option>
              <option id="3">国务院和中央军委</option>
            </options>
          </correctanswer>
        </question>
        <question id="2" type="multiple-choice" score="1">
          <description>我国专门针对业余无线电台的管理文件及其制定机构分别是：</description>
          <options>
            <option id="1">《业余无线电台管理办法》</option>
            <option id="2">《业余无线电台管理暂行规定》</option>
            <option id="3">工业和信息化部</option>
            <option id="4">国务院</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">《业余无线电台管理办法》</option>
              <option id="3">工业和信息化部</option>
            </options>
          </correctanswer>
        </question>
        <question id="3" type="single-choice" score="1">
          <description>我国依法负责对业余无线电台实施监督管理的机构是：</description>
          <options>
            <option id="1">国家无线电管理机构和省、自治区、直辖市无线电管理机构</option>
            <option id="2">在国家或地方民政部门注册的业余无线电协会</option>
            <option id="3">国家体育管理机构和地方体育管理机构</option>
            <option id="4">国家和地方公安部门</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">国家无线电管理机构和省、自治区、直辖市无线电管理机构</option>
            </options>
          </correctanswer>
        </question>
        <question id="4" type="single-choice" score="1">
          <description>我国对无线电管理术语“业余业务”、“卫星业余业务”和“业余电台”做出具体定义的法规文件是：</description>
          <options>
            <option id="1">《中华人民共和国无线电频率划分规定》</option>
            <option id="2">《中华人民共和国无线电管理条例》</option>
            <option id="3">《中华人民共和国电信条例》</option>
            <option id="4">《无线电台执照管理规定》</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">《中华人民共和国无线电频率划分规定》</option>
            </options>
          </correctanswer>
        </question>
        <question id="5" type="single-choice" score="1">
          <description>最新发布的《业余无线电台管理办法》自何时开始施行：</description>
          <options>
            <option id="1">自2024年3月1日起施行</option>
            <option id="2">自2024年12月1日起施行</option>
            <option id="3">自2025年3月1日起施行</option>
            <option id="4">自2025年12月1日起施行</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">自2024年3月1日起施行</option>
            </options>
          </correctanswer>
        </question>
        <question id="6" type="single-choice" score="1">
          <description>将某个特定的频段列入频率划分表，规定该频段可在指定的条件下供一种或多种地面或空间无线电通信业务或射电天文业务使用，这个过程称为：</description>
          <options>
            <option id="1">划分</option>
            <option id="2">分配</option>
            <option id="3">指配</option>
            <option id="4">授权</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">划分</option>
            </options>
          </correctanswer>
        </question>
        <question id="7" type="single-choice" score="1">
          <description>将无线电频率或频道规定由一个或多个部门，在指定的区域内供地面或空间无线电通信业务在指定条件下使用，这个过程称为：</description>
          <options>
            <option id="1">分配</option>
            <option id="2">划分</option>
            <option id="3">指配</option>
            <option id="4">授权</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">分配</option>
            </options>
          </correctanswer>
        </question>
        <question id="8" type="single-choice" score="1">
          <description>将无线电频率或频道批准给无线电台在规定条件下使用，这个过程称为：</description>
          <options>
            <option id="1">指配</option>
            <option id="2">划分</option>
            <option id="3">分配</option>
            <option id="4">授权</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">指配</option>
            </options>
          </correctanswer>
        </question>
        <question id="9" type="single-choice" score="1">
          <description>在频率划分表中，一个频段被标明划分给多种业务时，这些业务被分为下述类别：</description>
          <options>
            <option id="1">主要业务和次要业务</option>
            <option id="2">业余业务和非业余业务</option>
            <option id="3">民用业务和军用业务</option>
            <option id="4">安全业务和一般业务</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">主要业务和次要业务</option>
            </options>
          </correctanswer>
        </question>
        <question id="10" type="single-choice" score="1">
          <description>辐射（radiation）是指任何源的能量流以无线电波的形式向外发出。正确的说法是：</description>
          <options>
            <option id="1">闪电产生的电磁波干扰是一种辐射</option>
            <option id="2">沿电源线窜入接收机的差模干扰是一种辐射</option>
            <option id="3">射频电路中变压器内磁芯里的磁场是一种辐射</option>
            <option id="4">射频电路中电容器内极板间的电场是一种辐射</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">闪电产生的电磁波干扰是一种辐射</option>
            </options>
          </correctanswer>
        </question>
        <question id="11" type="single-choice" score="1">
          <description>发射（emission）是指：由无线电发信电台产生的辐射或辐射产物。正确的说法是：</description>
          <options>
            <option id="1">业余电台向周围发送的杂散产物是一种发射</option>
            <option id="2">无线电接收机本地振荡器辐射的能量是一种发射</option>
            <option id="3">医用高频电疗机向周围发送的无线电波能量是一种发射</option>
            <option id="4">闪电产生的电磁波干扰是一种发射</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">业余电台向周围发送的杂散产物是一种发射</option>
            </options>
          </correctanswer>
        </question>
        <question id="12" type="multiple-choice" score="1">
          <description>下列关于无线电的一般术语，说法正确的是：</description>
          <options>
            <option id="1">无线电测定是指利用无线电波的传播特性测定目标的位置、速度和/或其他特性，或获得与这些参数有关的信息</option>
            <option id="2">无线电导航是指用于导航（包括障碍物告警）的无线电测定</option>
            <option id="3">无线电定位是指用于除无线电导航以外的无线电测定</option>
            <option id="4">无线电测向是指利用接收无线电波来确定一个电台或目标的方向的无线电测定</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">无线电测定是指利用无线电波的传播特性测定目标的位置、速度和/或其他特性，或获得与这些参数有关的信息</option>
              <option id="2">无线电导航是指用于导航（包括障碍物告警）的无线电测定</option>
              <option id="3">无线电定位是指用于除无线电导航以外的无线电测定</option>
              <option id="4">无线电测向是指利用接收无线电波来确定一个电台或目标的方向的无线电测定</option>
            </options>
          </correctanswer>
        </question>
        <question id="13" type="single-choice" score="1">
          <description>关于业余无线电台，下列说法正确的是：</description>
          <options>
            <option id="1">业余无线电台是指为开展业余业务（含卫星业余业务）使用的一个或者多个发信机、收信机，或者发信机与收信机的组合（包括附属设备）</option>
            <option id="2">一个业余无线电台只能包含一个发信机</option>
            <option id="3">一个业余无线电台只能包含一个收信机</option>
            <option id="4">一个业余无线电台只能包含一个发信机和一个收信机</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">业余无线电台是指为开展业余业务（含卫星业余业务）使用的一个或者多个发信机、收信机，或者发信机与收信机的组合（包括附属设备）</option>
            </options>
          </correctanswer>
        </question>
        <question id="14" type="multiple-choice" score="1">
          <description>关于业余业务、卫星业余业务，下列说法正确的是：</description>
          <options>
            <option id="1">业余业务是指供业余无线电爱好者进行自我训练、相互通信和技术研究的无线电通信业务</option>
            <option id="2">卫星业余业务是指利用地球卫星上的空间电台开展与业余业务相同目的的无线电通信业务</option>
            <option id="3">业余无线电爱好者可以在业余业务、卫星业余业务以及其他的无线电业务相互通信</option>
            <option id="4">业余无线电台可以在业余业务、卫星业余业务以及其他的无线电业务进行通信</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">业余业务是指供业余无线电爱好者进行自我训练、相互通信和技术研究的无线电通信业务</option>
              <option id="2">卫星业余业务是指利用地球卫星上的空间电台开展与业余业务相同目的的无线电通信业务</option>
            </options>
          </correctanswer>
        </question>
        <question id="15" type="multiple-choice" score="1">
          <description>关于业余无线电爱好者的定义，下列说法正确的是：</description>
          <options>
            <option id="1">业余无线电爱好者系指经正式批准的、对无线电技术有兴趣的人</option>
            <option id="2">其兴趣纯系个人爱好而不涉及谋取利润</option>
            <option id="3">其兴趣纯系个人爱好可涉及谋取利润</option>
            <option id="4">只有成年人能成为业余无线电爱好者</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">业余无线电爱好者系指经正式批准的、对无线电技术有兴趣的人</option>
              <option id="2">其兴趣纯系个人爱好而不涉及谋取利润</option>
            </options>
          </correctanswer>
        </question>
        <question id="16" type="multiple-choice" score="1">
          <description>关于发射类别，下列说法正确的是：</description>
          <options>
            <option id="1">是指用标准符号标示的某发射的一组特性</option>
            <option id="2">标示的特性例如主载波调制方式，调制信号，被发送信息的类型以及其他适用的信号特性</option>
            <option id="3">一个业余无线电台只能包含一个收信机</option>
            <option id="4">一个业余无线电台只能包含一个发信机和一个收信机</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">是指用标准符号标示的某发射的一组特性</option>
              <option id="2">标示的特性例如主载波调制方式，调制信号，被发送信息的类型以及其他适用的信号特性</option>
            </options>
          </correctanswer>
        </question>
        <question id="17" type="single-choice" score="1">
          <description>关于单边带发射，下列说法正确的是：</description>
          <options>
            <option id="1">单边带发射是只传送一个边带的调幅发射</option>
            <option id="2">单边带发射是只传送一个边带的调频发射</option>
            <option id="3">单边带发射是不传送载波的调幅发射</option>
            <option id="4">单边带发射是不传送载波的调频发射</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">单边带发射是只传送一个边带的调幅发射</option>
            </options>
          </correctanswer>
        </question>
        <question id="18" type="multiple-choice" score="1">
          <description>关于干扰的定义，下列说法正确的是：</description>
          <options>
            <option id="1">由于一种或多种发射、辐射、感应或其组合所产生的无用能量对无线电通信系统的接收产生的影响</option>
            <option id="2">表现为性能下降、误解或信息丢失</option>
            <option id="3">若不存在这种无用能量，则此后果可以避免</option>
            <option id="4">不会对无线电通信系统的接收产生的影响</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">由于一种或多种发射、辐射、感应或其组合所产生的无用能量对无线电通信系统的接收产生的影响</option>
              <option id="2">表现为性能下降、误解或信息丢失</option>
              <option id="3">若不存在这种无用能量，则此后果可以避免</option>
            </options>
          </correctanswer>
        </question>
        <question id="19" type="multiple-choice" score="1">
          <description>关于有害干扰的定义，下列说法正确的是：</description>
          <options>
            <option id="1">危害无线电导航或其他安全业务的正常运行的干扰</option>
            <option id="2">严重地损害、阻碍、或一再阻断按规定正常开展的无线电通信业务的干扰</option>
            <option id="3">产生有害干扰不会受到处罚</option>
            <option id="4">使用业余无线电台时，只要不对其他业余无线电台产生干扰即可</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">危害无线电导航或其他安全业务的正常运行的干扰</option>
              <option id="2">严重地损害、阻碍、或一再阻断按规定正常开展的无线电通信业务的干扰</option>
            </options>
          </correctanswer>
        </question>
        <question id="20" type="multiple-choice" score="1">
          <description>关于次要业务台站，下列说法正确的是：</description>
          <options>
            <option id="1">不得对业经指配或将来可能指配频率的主要业务电台产生有害干扰</option>
            <option id="2">不得对来自业经指配或将来可能指配频率的主要业务电台的有害干扰提出保护要求</option>
            <option id="3">可要求保护不受来自将来可能指配频率的同一业务或其他次要业务电台的有害干扰</option>
            <option id="4">使用业余无线电台时，只要不对其他业余无线电台产生干扰即可</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">不得对业经指配或将来可能指配频率的主要业务电台产生有害干扰</option>
              <option id="2">不得对来自业经指配或将来可能指配频率的主要业务电台的有害干扰提出保护要求</option>
              <option id="3">可要求保护不受来自将来可能指配频率的同一业务或其他次要业务电台的有害干扰</option>
            </options>
          </correctanswer>
        </question>
        <question id="21" type="single-choice" score="1">
          <description>协调国际无线电管理的国际组织是：</description>
          <options>
            <option id="1">国际电信联盟</option>
            <option id="2">国际业余无线电联盟</option>
            <option id="3">联合国大会</option>
            <option id="4">联合国科教文组织</option>
          </options>
          <correctanswer>
            <options>
              <option id="1">国际电信联盟</option>
            </options>
          </correctanswer>
        </question>
        <question id="22" type="single-choice" score="1">
          <description>国际业余无线电联盟支持会员协会在发展业余无线电时把它看成一种：</description>
          <options>
            <option id="1">国家资源</option>
            <option id="2">拉动经济的措施</option>
            <option id="3">休闲娱乐手段</option>
