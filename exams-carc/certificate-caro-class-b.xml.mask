          </correctanswer>
        </question>
        <question id="23" type="single-choice" score="1">
          <description>下述通信不属于电信（telecommunication）范畴：</description>
          <options>
            <option id="1">邮政通信</option>
            <option id="2">有线通信</option>
            <option id="3">无线电通信</option>
            <option id="4">光通信</option>
          </options>
